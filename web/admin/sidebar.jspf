<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<%@ page pageEncoding="UTF-8" %>
<div class="bg-dark text-white position-fixed top-0 start-0 vh-100 px-1 py-2 d-flex flex-column"
     style="width:180px; z-index:1000;">

    <h6 class="text-center mt-2 d-flex justify-content-center align-items-center gap-2"> 
        <img src="${pageContext.request.contextPath}/images/icons/shop-icon.png" alt="shop"
             width="40" height="40" class=""/>
        Shop Manager
    </h6>
    <ul class="nav flex-column">
        <li class="nav-item mt-2">
            <c:if test="${sessionScope.user.roleInSystem != 0}">
                <a class="nav-link text-white ${activePage == 'dashboard' ? 'active' : ''}" 
                   href="${pageContext.request.contextPath}/admin/dashboard.jsp" role="button">
                    <img src="${pageContext.request.contextPath}/images/icons/analytics-icon.png" alt="account"
                         width="25" height="25" class="mb-1"/>
                    Dashboard
                </a>
            </c:if>
        </li>
        <!-- Accounts -->
        <li class="nav-item mt-2">
            <a class="nav-link text-white ${activePage == 'accounts' ? 'active' : ''}" 
               href="${pageContext.request.contextPath}/admin/account?action=list" role="button">
                <img src="${pageContext.request.contextPath}/images/icons/account-icon-2.png" alt="account"
                     width="25" height="25" class="mb-1"/>
                Accounts
            </a>
        </li>

        <!-- Products -->
        <li class="nav-item mt-2">
            <a class="nav-link text-white ${activePage == 'products' ? 'active' : ''}" 
               href="${pageContext.request.contextPath}/admin/product?action=list" role="button">
                <img src="${pageContext.request.contextPath}/images/icons/product-icon-2.png" alt="account"
                     width="25" height="25" class="mb-1"/>
                Products
            </a>
        </li>

        <!-- Categories -->
        <li class="nav-item mt-2">
            <a class="nav-link text-white${activePage == 'categories' ? 'active' : ''}" 
               href="${pageContext.request.contextPath}/admin/category?action=list" role="button">
                <img src="${pageContext.request.contextPath}/images/icons/category-icon.png" alt="account"
                     width="25" height="25" class="mb-1"/>
                Categories
            </a>
        </li>

    </ul>

    <!--Profile-->
    <div class="nav-item dropdown mt-auto text-center mb-3">
        <a class="navbar-brand" href="#" role="button" data-bs-toggle="dropdown">
            <c:choose>
                <c:when test="${empty sessionScope.user}">
                    <img src="${pageContext.request.contextPath}/images/avatar_placeholder.png.png"
                         class="rounded-circle mb-1"
                         width="45"
                         height="45"
                         alt="profile">
                </c:when>
                <c:when test="${sessionScope.user.gender}">
                    <img src="${pageContext.request.contextPath}/images/img_avatar1.png"
                         class="rounded-circle mb-1"
                         width="45"
                         height="45"
                         alt="profile">
                </c:when>
                <c:otherwise>
                    <img src="${pageContext.request.contextPath}/images/img_avatar2.png"
                         class="rounded-circle mb-1"
                         width="45"
                         height="45"
                         alt="profile">
                </c:otherwise>
            </c:choose>
        </a>
        <ul class="dropdown-menu dropdown-menu-end">
            <c:if test="${sessionScope.user != null && sessionScope.user.roleInSystem == 0}">
                <li>
                    <a class="dropdown-item d-flex align-items-center gap-2" href="#">
                        <img src="${pageContext.request.contextPath}/images/icons/profile-black-icon.png"
                             style="width:20px; height:20px;" class="inline">
                        Profile
                    </a>
                </li>
            </c:if>
            <c:choose>
                <c:when test="${empty sessionScope.user}">
                    <li>
                        <a class="dropdown-item d-flex align-items-center gap-2" href="${pageContext.request.contextPath}/login">Login</a>
                    </li>
                </c:when>
                <c:otherwise>
                    <li>
                        <a class="dropdown-item d-flex align-items-center gap-2"
                           href="${pageContext.request.contextPath}/home.jsp">
                            <img src="${pageContext.request.contextPath}/images/icons/home-icon.png"
                                 style="width:20px; height:20px;">
                            View Store
                        </a>
                    </li>
                    <li>
                        <a class="dropdown-item d-flex align-items-center gap-2" href="${pageContext.request.contextPath}/logout">
                            <img src="${pageContext.request.contextPath}/images/icons/logout-black-icon-2.png"
                                 style="width:20px; height:20px;" class="inline">
                            Sign Out
                        </a>
                    </li>
                </c:otherwise>    
            </c:choose>
        </ul>
        <div style="font-size:14px;">
            ${sessionScope.user.lastName} ${sessionScope.user.firstName} 
        </div>

        <div class="text-secondary" style="font-size:12px;">
            <c:choose>
                <c:when test="${sessionScope.user.roleInSystem == 1}">
                    <span class="text-danger fw-bold">Admin</span>
                </c:when>
                <c:when test="${sessionScope.user.roleInSystem == 2}">
                    <span class="text-white fw-bold">Staff</span>
                </c:when>
            </c:choose>
        </div>

    </div>
</div>