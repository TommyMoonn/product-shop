<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<%@ page pageEncoding="UTF-8" %>
<div class="bg-dark text-white position-fixed top-0 start-0 vh-100 p-1"
     style="width:180px; z-index:1000;">

    <h6 class="text-center mt-2"> 
        <img src="${pageContext.request.contextPath}/images/icons/shop-icon.png" alt="shop"
             width="40" height="40" class=""/>
        Shop Manager
    </h6>
    <hr>
    <ul class="nav flex-column">
        <li class="nav-item mt-2">
            <c:if test="${sessionScope.user.roleInSystem != 0}">
                <a class="nav-link text-white ${activePage == 'dashboard' ? 'active' : ''}" 
                   href="${pageContext.request.contextPath}/admin/dashboard.jsp" role="button">
                    <img src="${pageContext.request.contextPath}/images/icons/dashboard-icon.png" alt="account"
                     width="27" height="27" class="mb-1"/>
                    Dashboard
                </a>
            </c:if>
        </li>
        <!-- Accounts -->
        <li class="nav-item dropdown mt-2">

            <a class="nav-link text-white dropdown-toggle ${activePage == 'accounts' ? 'active' : ''}" href="#" role="button" data-bs-toggle="dropdown">
                <img src="${pageContext.request.contextPath}/images/icons/account-icon.png" alt="account"
                     width="30" height="30" class="mb-1"/>
                Accounts
            </a>
            <ul class="dropdown-menu">
                <li>
                    <a class="dropdown-item" href="${pageContext.request.contextPath}/admin/account?action=list">List of accounts</a>
                </li>
                <li>
                    <a class="dropdown-item" href="${pageContext.request.contextPath}/admin/account?action=add">Register new account</a>
                </li>
            </ul>
        </li>

        <!-- Products -->
        <li class="nav-item dropdown mt-2">
            <a class="nav-link text-white dropdown-toggle ${activePage == 'products' ? 'active' : ''}" href="#" role="button" data-bs-toggle="dropdown">
                <img src="${pageContext.request.contextPath}/images/icons/product-icon.png" alt="account"
                     width="30" height="30" class="mb-1"/>
                Products
            </a>
            <ul class="dropdown-menu">
                <li>
                    <a class="dropdown-item" href="${pageContext.request.contextPath}/admin/product?action=list">Product listings</a>
                </li>
                <li>
                    <a class="dropdown-item" href="${pageContext.request.contextPath}/admin/product?action=add">Add new product</a>
                </li>
            </ul>
        </li>

        <!-- Categories -->
        <li class="nav-item dropdown mt-2">
            <a class="nav-link text-white dropdown-toggle ${activePage == 'categories' ? 'active' : ''}" href="#" role="button" data-bs-toggle="dropdown">
                <img src="${pageContext.request.contextPath}/images/icons/category-icon-2.png" alt="account"
                     width="30" height="30" class="mb-1"/>
                Categories
            </a>
            <ul class="dropdown-menu">
                <li>
                    <a class="dropdown-item" href="${pageContext.request.contextPath}/admin/category?action=list">List of categories</a>
                </li>
                <li>
                    <a class="dropdown-item" href="${pageContext.request.contextPath}/admin/category?action=add">Add new category</a>
                </li>
            </ul>
        </li>

    </ul>

</div>