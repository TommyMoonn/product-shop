<%-- any content can be specified here e.g.: --%>

<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<%@ page pageEncoding="UTF-8" %>
<!-- Grey with black text -->
<nav class="navbar navbar-expand-sm bg-dark navbar-dark">
    <div class="container-fluid">
        <ul class="navbar-nav w-100">
            <li class="nav-item">
                <span class="nav-link navbar-brand">
                    <c:choose>
                        <c:when test="${empty sessionScope.user}">
                            Welcome, Guest!
                        </c:when>
                        <c:when test="${sessionScope.user.roleInSystem == 1}">
                            Welcome <span style="color:red;">admin</span>, ${sessionScope.user.firstName}!
                        </c:when>
                        <c:otherwise>
                            Welcome, ${sessionScope.user.firstName}!
                        </c:otherwise>    
                    </c:choose>
                </span>
            </li>
            <li class="nav-item">
                <a class="nav-link  ${activePage == 'home' ? 'active' : ''}" href="${pageContext.request.contextPath}" role="button">Home</a>
            </li>
            <li class="nav-item dropdown">
                <a class="nav-link dropdown-toggle ${activePage == 'accounts' ? 'active' : ''}" href="#" role="button" data-bs-toggle="dropdown">Accounts</a>
                <ul class="dropdown-menu">
                    <li>
                        <a class="dropdown-item" href="${pageContext.request.contextPath}/auth?type=account&action=list">List of accounts</a>
                    </li>
                    <li>
                        <a class="dropdown-item" href="${pageContext.request.contextPath}/auth?type=account&action=add">Register new account</a>
                    </li>
                </ul>
            </li>
            <li class="nav-item dropdown">
                <a class="nav-link dropdown-toggle ${activePage == 'products' ? 'active' : ''}" href="#" role="button" data-bs-toggle="dropdown">Products</a>
                <ul class="dropdown-menu">
                    <li>
                        <a class="dropdown-item" href="${pageContext.request.contextPath}/auth?type=product&action=list">Product listings</a>
                    </li>
                    <li>
                        <a class="dropdown-item" href="${pageContext.request.contextPath}/auth?type=product&action=add">Add new product</a>
                    </li>
                </ul>
            </li>
            <li class="nav-item dropdown">
                <a class="nav-link dropdown-toggle ${activePage == 'categories' ? 'active' : ''}" href="#" role="button" data-bs-toggle="dropdown">Categories</a>
                <ul class="dropdown-menu">
                    <li>
                        <a class="dropdown-item" href="${pageContext.request.contextPath}/auth?type=category&action=list">List of categories</a>
                    </li>
                    <li>
                        <a class="dropdown-item" href="${pageContext.request.contextPath}/auth?type=category&action=add">Add new category</a>
                    </li>
                </ul>
            </li>
            <li class="nav-item dropdown ms-auto">
                <a class="navbar-brand" href="#" role="button" data-bs-toggle="dropdown">
                    <c:choose>
                        <c:when test="${empty sessionScope.user}">
                            <img src="${pageContext.request.contextPath}/images/avatar_placeholder.png" alt="Logo" style="width:40px;" class="rounded-pill">
                        </c:when>
                        <c:otherwise>
                            <img src="${pageContext.request.contextPath}/images/img_avatar1.png" alt="Logo" style="width:40px;" class="rounded-pill">
                        </c:otherwise>
                    </c:choose>
                </a> 
                <ul class="dropdown-menu dropdown-menu-end">
                    <c:choose>
                        <c:when test="${empty sessionScope.user}">
                            <li>
                                <a class="dropdown-item" href="${pageContext.request.contextPath}/login">Login</a>
                            </li>
                        </c:when>
                        <c:otherwise>
                            <li>
                                <a class="dropdown-item" href="${pageContext.request.contextPath}/logout">Logout</a>
                            </li>
                        </c:otherwise>    
                    </c:choose>
                </ul>
            </li>
        </ul>
    </div>
</nav>
