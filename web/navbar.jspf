<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<%@ page pageEncoding="UTF-8" %>

<nav class="navbar navbar-expand-sm navbar-dark shop-navbar"
     style="${isAdminPage ? 'margin-left:180px;' : ''}">

    <div class="container-fluid">

        <!-- BRAND -->
        <a class="navbar-brand d-flex align-items-center gap-2"
           href="${pageContext.request.contextPath}/home">

            <img src="${pageContext.request.contextPath}/images/icons/shop-icon.png"
                 width="38" height="38">

            <span class="brand-text">Product Shop</span>
        </a>


        <!-- LEFT NAV LINKS -->
        <ul class="navbar-nav align-items-center">

            <li class="nav-item">
                <a class="nav-link ${activePage == 'home' ? 'active' : ''}"
                   href="${pageContext.request.contextPath}/home">
                    Home
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link ${activePage == 'store' ? 'active' : ''}"
                   href="${pageContext.request.contextPath}/product?action=list">
                    Shop
                </a>
            </li>

            <c:if test="${sessionScope.user.roleInSystem != null && sessionScope.user.roleInSystem == 0}">
                <li class="nav-item">
                    <a class="nav-link ${activePage == 'history' ? 'active' : ''}"
                       href="${pageContext.request.contextPath}/user/history">
                        History
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link ${activePage == 'order' ? 'active' : ''}"
                       href="${pageContext.request.contextPath}/user/order">
                        My Orders
                    </a>
                </li>
            </c:if>

            <c:if test="${sessionScope.user.roleInSystem != null && sessionScope.user.roleInSystem > 0 && !isAdminPage}">
                <li class="nav-item">
                    <a class="nav-link ${activePage == 'dashboard' ? 'active' : ''}"
                       href="${pageContext.request.contextPath}/admin/dashboard.jsp">
                        Admin Panel
                    </a>
                </li>
            </c:if>

        </ul>


        <!-- RIGHT SIDE -->
        <ul class="navbar-nav ms-auto align-items-center">

            <!-- CART -->
            <c:if test="${sessionScope.user.roleInSystem != null && sessionScope.user.roleInSystem == 0}">
                <li class="nav-item">
                    <a class="nav-link ${activePage == 'cart' ? 'active' : ''} d-flex align-items-center gap-1"
                       href="${pageContext.request.contextPath}/user/cart">

                        <img src="${pageContext.request.contextPath}/images/icons/cart-icon.png"
                             class="nav-icon">

                        Cart
                    </a>
                </li>
            </c:if>


            <!-- LOGIN / LOGOUT -->
            <c:choose>

                <c:when test="${empty sessionScope.user}">
                    <li class="nav-item">
                        <a class="nav-link d-flex align-items-center gap-1"
                           href="${pageContext.request.contextPath}/login">

                            <img src="${pageContext.request.contextPath}/images/icons/login-icon.png"
                                 class="nav-icon">

                            Login
                        </a>
                    </li>
                </c:when>

                <c:otherwise>
                    <li class="nav-item">
                        <a class="nav-link d-flex align-items-center gap-1"
                           href="${pageContext.request.contextPath}/logout">

                            <img src="${pageContext.request.contextPath}/images/icons/logout-icon-2.png"
                                 class="nav-icon">

                            Sign Out
                        </a>
                    </li>
                </c:otherwise>

            </c:choose>


            <!-- AVATAR -->
            <li class="nav-item ms-2">

                <a class="nav-link avatar-link" href="#">

                    <c:choose>

                        <c:when test="${empty sessionScope.user}">
                            <img src="${pageContext.request.contextPath}/images/avatar_placeholder.png"
                                 class="avatar-img">
                        </c:when>

                        <c:when test="${sessionScope.user.gender}">
                            <img src="${pageContext.request.contextPath}/images/img_avatar1.png"
                                 class="avatar-img">
                        </c:when>

                        <c:otherwise>
                            <img src="${pageContext.request.contextPath}/images/img_avatar2.png"
                                 class="avatar-img">
                        </c:otherwise>

                    </c:choose>

                </a>

            </li>

        </ul>

    </div>

</nav>