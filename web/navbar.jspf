<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<%@ page pageEncoding="UTF-8" %>
<!-- Grey with black text -->
<nav class="navbar navbar-expand-sm bg-dark navbar-dark"
     style="${isAdminPage ? 'margin-left:180px;' : ''}">
    <div class="container-fluid">
        <ul class="navbar-nav w-100">
            <li class="nav-item nav-brand me-2 d-flex align-items-center gap-2">
                <a href="${pageContext.request.contextPath}/home.jsp">
                    <img src="${pageContext.request.contextPath}/images/icons/shop-icon.png"
                         width="40" height="40">
                </a>
                <span class="fw-bold">Product Shop </span>
            </li>
            <li class="nav-item">
                <a class="nav-link  ${activePage == 'home' ? 'active' : ''}" 
                   href="${pageContext.request.contextPath}/home" role="button">
                    Home
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link  ${activePage == 'store' ? 'active' : ''}" 
                   href="${pageContext.request.contextPath}/product?action=list" role="button">
                    Shop
                </a>
            </li>
            <c:if test="${sessionScope.user.roleInSystem != null && sessionScope.user.roleInSystem == 0}">
                <li class="nav-item">
                    <a class="nav-link  ${activePage == 'history' ? 'active' : ''}" 
                       href="${pageContext.request.contextPath}/user/history" role="button">
                        History
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link  ${activePage == 'order' ? 'active' : ''}" 
                       href="${pageContext.request.contextPath}/user/order" role="button">
                        My Orders
                    </a>
                </li>
            </c:if>
            <c:if test="${sessionScope.user.roleInSystem != null && sessionScope.user.roleInSystem > 0 && !isAdminPage}">
                <li class="nav-item">
                    <a class="nav-link  ${activePage == 'dashboard' ? 'active' : ''}" 
                       href="${pageContext.request.contextPath}/admin/dashboard.jsp" role="button">Admin Panel</a>
                </li>
            </c:if>
            <c:choose>
                <c:when test="${empty sessionScope.user}">
                    <li class="nav-item ms-auto">
                        <a class="nav-link d-flex justify-content-center align-items-center gap-1" href="${pageContext.request.contextPath}/login">
                            <img src="${pageContext.request.contextPath}/images/icons/login-icon.png"
                                 style="width:20px; height:20px;" class="inline">
                            Login
                        </a>
                    </li>
                </c:when>
                <c:otherwise>
                    <li class="nav-item ms-auto">
                        <a class="nav-link d-flex justify-content-center align-items-center gap-1" href="${pageContext.request.contextPath}/logout">
                            <img src="${pageContext.request.contextPath}/images/icons/logout-icon-2.png"
                                 style="width:20px; height:20px;" class="inline">
                            Sign Out
                        </a>
                    </li>
                </c:otherwise>    
            </c:choose>
            <c:if test="${sessionScope.user.roleInSystem != null && sessionScope.user.roleInSystem == 0}">
                <li class="nav-item ">
                    <a class="nav-link ${activePage == 'cart' ? 'active' : ''} d-flex justify-content-center align-items-center gap-1"
                       href="${pageContext.request.contextPath}/user/cart" role="button">
                        <img src="${pageContext.request.contextPath}/images/icons/cart-icon.png"
                             style="width:21px; height:21px;" class="inline">
                        Cart
                    </a>
                </li>
            </c:if>
            <li class="nav-item ms-2">
                <a class="navbar-brand" href="#" role="button">
                    <c:choose>
                        <c:when test="${empty sessionScope.user}">
                            <img src="${pageContext.request.contextPath}/images/avatar_placeholder.png" alt="Logo" style="width:40px;" class="rounded-pill">
                        </c:when>
                        <c:when test="${sessionScope.user.gender}">
                            <img src="${pageContext.request.contextPath}/images/img_avatar1.png"
                                 style="width:40px;" class="rounded-pill" alt="avatar">
                        </c:when>
                        <c:otherwise>
                            <img src="${pageContext.request.contextPath}/images/img_avatar2.png"
                                 style="width:40px;" class="rounded-pill" alt="avatar">
                        </c:otherwise>
                    </c:choose>
                </a> 
                <ul class="dropdown-menu dropdown-menu-end">

                </ul>
            </li>
        </ul>
    </div>
</nav>
